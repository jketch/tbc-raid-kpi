# Secrets — WCL client id/secret. NEVER commit.
.env

# Python
__pycache__/
*.pyc
*.pyo

# Combat logs (large, not source) — keep the placeholder README
logs/*.txt
!logs/README.txt

# ThatsBIS loot CSV exports (player data, not source) — keep the placeholder README
loot/*.csv
!loot/README.txt
# stray ThatsBIS exports dropped in the repo root (e.g. attendance) — never source
/*.csv

# Generated screenshots / exports
screenshots/

# Caches & history databases (regenerated by the pipeline; never committed)
cache/*.db
cache/*.json
# per-week mapped WEEK_DATA snapshots (offline reprocess source, ~MB each)
cache/week_data/
# (future) raw merged wcl-dict snapshots
cache/wcl/

# Claude Code machine-local settings
.claude/settings.local.json
CLAUDE.md
# Maintainer-local session handoff (same species as CLAUDE.md — never ship to clones)
HANDOFF.md

# Generated dashboard output (template is the source; output is gitignored to keep real data out of the repo)
dashboard/raid_kpi_dashboard.html

# Netlify (deploy state + the staged copy of the dashboard) and node deps
.netlify/
.deploy/
node_modules/

# Local scratch prompt files (pasted into Claude Code, not source)
prompts/

# OS cruft
.DS_Store
Thumbs.db
