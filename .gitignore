# Secrets — WCL client id/secret. NEVER commit.
.env

# Python
__pycache__/
*.pyc
*.pyo

# Combat logs (large, not source) — keep the placeholder README
logs/*.txt
!logs/README.txt
# zipped post-run log archives + cloud drop-folder downloads (CI scratch)
logs/archive/
drops/

# ThatsBIS loot CSV exports (player data, not source) — keep the placeholder README
loot/*.csv
!loot/README.txt
# stray ThatsBIS exports dropped in the repo root (e.g. attendance) — never source
/*.csv

# Generated screenshots / exports
screenshots/

# Caches, history DBs, snapshots & rendered baselines — the WHOLE cache/ folder is generated/
# runtime and machine-local. The canonical copy of the real-raid data (week_data / wcl /
# raid_history.db) lives on the orphan `data` branch via tools/sync_state.py, NOT on main.
# Ignoring the whole folder closes the piecemeal gaps that leaked into diffs/PRs — e.g.
# cache/replay_baseline.html (~25k lines), cache/.data_branch_sync, and FUSE .fuse_hidden* cruft.
cache/

# Claude Code config — kept entirely local (same stance as CLAUDE.md: no Claude tooling ships to clones)
.claude/
CLAUDE.md
# Maintainer-local session handoff (same species as CLAUDE.md — never ship to clones)
HANDOFF.md

# Generated dashboard output (template is the source; output is gitignored to keep real data out of the repo)
dashboard/raid_kpi_dashboard.html

# Netlify (deploy state + the staged copy of the dashboard) and node deps
.netlify/
.deploy/
node_modules/

# Local scratch prompt files (pasted into Claude Code, not source)
prompts/

# OS cruft
.DS_Store
Thumbs.db
