# Copy this file to ".env" and fill in real values. .env is gitignored — never commit it.

# WarcraftLogs API client (https://www.warcraftlogs.com/api/clients/)
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Optional: your WoW client's Logs folder. When set, the weekly run reads the combat log
# straight from the game — no copying into logs/. The right file is MATCHED against the
# report's time window (an alt session's log can't be picked by accident), and the consumed
# log is zipped into logs/archive/ after a successful run.
# WOW_LOG_DIR=C:\Program Files (x86)\World of Warcraft\_classic_\Logs

# Optional: override the title shown in the dashboard header and browser tab.
# Default: "Raid KPI Dashboard — TBC Anniversary"
# DASHBOARD_TITLE=My Guild — Raid KPI Dashboard

# Optional: enables the officer-only AI performance summaries (one-line notes per raider on the
# Performance tab). Pay-as-you-go Anthropic key from https://console.anthropic.com (Settings → API
# Keys). Pennies/week on the default Haiku model. Leave blank to disable — the dashboard is unaffected.
# ANTHROPIC_API_KEY=
# PERF_SUMMARY_MODEL=claude-haiku-4-5

# Netlify hosting (optional — publish.py skips the deploy if unset).
# Personal access token: app.netlify.com → User settings → Applications → New access token.
NETLIFY_AUTH_TOKEN=
# Site ID: app.netlify.com → your site → Site configuration → Site details → Site ID.
# Normally not needed — the id is read from .netlify/state.json if the site was linked
# there; set this to override it (or for CI, where .netlify/ doesn't exist).
# NETLIFY_SITE_ID=

# Discord webhook for the weekly auto-post (your raid channel →
#   Edit Channel → Integrations → Webhooks → New Webhook → Copy URL).
# Leave blank until set up; publish.py skips the Discord post if empty.
DISCORD_WEBHOOK_URL=
